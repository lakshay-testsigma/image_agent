# Copy to .env and fill in. Every model role speaks the OpenAI-compatible chat API,
# so DeepSeek, Ollama, LM Studio, vLLM, OpenRouter, Together, Groq ... all work.

# ── Research model: reads saved source pages and extracts product facts with quotes ──
RESEARCH_BASE_URL=https://api.deepseek.com
RESEARCH_API_KEY=
RESEARCH_MODEL=deepseek-chat

# ── Fact-check model: independently re-verifies every claim against the source text ──
# Best practice: use a DIFFERENT model than research so errors don't repeat.
FACTCHECK_BASE_URL=https://api.deepseek.com
FACTCHECK_API_KEY=
FACTCHECK_MODEL=deepseek-reasoner
# Local alternative (Ollama):
# FACTCHECK_BASE_URL=http://localhost:11434/v1
# FACTCHECK_API_KEY=ollama
# FACTCHECK_MODEL=qwen2.5:14b

# ── Vision model (optional): describes product photos / second opinion in QA ──
# Leave VISION_MODEL empty and the orchestrating agent (Claude / Codex) inspects images itself.
VISION_BASE_URL=http://localhost:11434/v1
VISION_API_KEY=ollama
VISION_MODEL=

# ── Image generation: OpenAI gpt-image ──
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=high
IMAGE_SIZE=1024x1024
# high = keep product details (logo, label, shape) closest to the reference photo
IMAGE_INPUT_FIDELITY=high

# ── Web search (optional): tavily | brave | searxng ──
# Leave empty and the agent uses its own web search tool, then saves pages with `studio.py fetch`.
SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=http://localhost:8080

# ── Tuning ──
RESEARCH_MAX_SOURCE_CHARS=24000
